  "fixed_sql": [
    {
      "name": "food_search",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE VIRTUAL TABLE IF NOT EXISTS \"food_search\" USING fts5(food_id UNINDEXED, body, tokenize = 'unicode61 remove_diacritics 2');"
        }
      ]
    },
    {
      "name": "foods",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"foods\" (\"id\" TEXT NOT NULL, \"source\" TEXT NOT NULL, \"taco_number\" INTEGER NULL, \"name\" TEXT NOT NULL, \"search_text\" TEXT NOT NULL, \"category\" TEXT NULL, \"kcal\" REAL NULL, \"protein\" REAL NULL, \"carb\" REAL NULL, \"fat\" REAL NULL, \"fiber\" REAL NULL, \"sodium\" REAL NULL, \"nutrients_json\" TEXT NULL, \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "foods_search_insert",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TRIGGER foods_search_insert AFTER INSERT ON foods BEGIN INSERT INTO food_search (food_id, body) VALUES (new.id, new.search_text);END"
        }
      ]
    },
    {
      "name": "foods_search_update",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TRIGGER foods_search_update AFTER UPDATE OF search_text ON foods BEGIN DELETE FROM food_search WHERE food_id = old.id;INSERT INTO food_search (food_id, body) VALUES (new.id, new.search_text);END"
        }
      ]
    },
    {
      "name": "foods_search_delete",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TRIGGER foods_search_delete AFTER DELETE ON foods BEGIN DELETE FROM food_search WHERE food_id = old.id;END"
        }
      ]
    },
    {
      "name": "measures",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"measures\" (\"id\" TEXT NOT NULL, \"food_id\" TEXT NOT NULL REFERENCES foods (id), \"source\" TEXT NOT NULL, \"label\" TEXT NOT NULL, \"grams\" REAL NOT NULL, \"reference\" TEXT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
